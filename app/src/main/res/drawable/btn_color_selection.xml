<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed: Darken effect -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp" android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#26000000" /> <!-- ~15% black to soften -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Hovered: Darken effect -->
    <item android:state_hovered="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp" android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#1A000000" /> <!-- ~10% black -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal: White base for solid tinting -->
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp" android:left="2dp" android:top="2dp">
                <shape>
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>