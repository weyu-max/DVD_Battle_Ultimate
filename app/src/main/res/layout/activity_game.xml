<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.darkonly.dvdbattleultimate.GameView
        android:id="@+id/game_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_pause"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:text="||"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/btn_retro_classic"
        android:textColor="@color/black"
        android:alpha="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="RAID: 01"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold|italic"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_match_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_score"
        app:layout_constraintStart_toStartOf="@id/text_score" />

    <LinearLayout
        android:id="@+id/sysadmin_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/text_admin_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU POWER: 100%"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_admin_help"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:text="\?"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_inject_shield"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:text="@string/btn_inject_shield"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_force_heal"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:text="@string/btn_force_heal"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_system_lag"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:text="@string/btn_system_lag"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/p1_action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Individual Cooldown Bars (Private to this device) -->
        <ProgressBar
            android:id="@+id/progress_dash_p1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="8dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/imperial_blue" />

        <ProgressBar
            android:id="@+id/progress_parry_p1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="8dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_parry_p1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_retro_classic"
                    android:alpha="0.5" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_parry_hand"
                    android:alpha="0.7"
                    android:clickable="false" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_action"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_retro_classic"
                    android:alpha="0.5" />

                <ImageView
                    android:id="@+id/img_powerup_p1"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:alpha="0.8"
                    android:clickable="false"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_powerup_p1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/powerup_none"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/p2_action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/progress_dash_p2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="8dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progressTint="@color/imperial_blue" />

        <ProgressBar
            android:id="@+id/progress_parry_p2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="8dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progressTint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_action_p2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_retro_classic"
                    android:alpha="0.5" />

                <ImageView
                    android:id="@+id/img_powerup_p2"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:alpha="0.8"
                    android:clickable="false"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_parry_p2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_retro_classic"
                    android:alpha="0.5" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_parry_hand"
                    android:alpha="0.7"
                    android:clickable="false" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_powerup_p2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/powerup_none"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_start_promotion"
        android:layout_width="260dp"
        android:layout_height="80dp"
        android:text="@string/promotion_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/btn_retro_classic"
        android:textColor="@color/enemy_color"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/overlay_pause"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#AA000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause_text"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_resume"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="@string/btn_resume"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pause_recomecar"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="@string/btn_recomecar"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_pause_menu"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="@string/btn_menu"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_game_over"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#DD000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/win_text"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold|italic"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/container_game_over_rank"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/edittext_retro"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_over_rank_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RANK: BRONZE"
                android:textColor="@color/imperial_yellow"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_over_rank"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginVertical="8dp"
                android:max="100"
                android:progressTint="@color/imperial_blue" />

            <TextView
                android:id="@+id/text_over_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPLOAD: 0%"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_recomecar"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="@string/btn_recomecar"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_menu"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="@string/btn_menu"
            android:background="@drawable/btn_retro_classic"
            android:textColor="@color/black"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>