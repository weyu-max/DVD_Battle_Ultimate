<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/modes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".ModesActivity">

    <!-- LEFT PANEL: RANK AND SEASON -->
    <LinearLayout
        android:id="@+id/left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Ranked Box -->
        <LinearLayout
            android:id="@+id/btn_mode_ranked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_retro_classic"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_mode_ranked"
                android:textColor="@color/black"
                android:textStyle="bold|italic"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progress_upload"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/imperial_blue" />

            <TextView
                android:id="@+id/text_upload_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0%"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Season Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/label_season"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_event_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="EVENTO"
            android:textColor="@color/imperial_yellow"
            android:textStyle="bold|italic"
            android:textSize="18sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_event_rules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Regras do evento"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:gravity="center" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_back_modes"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:background="@drawable/btn_retro_classic"
            android:text="@string/btn_back"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RIGHT PANEL: MODES GRID -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_panel"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="16dp"
            android:alignmentMode="alignMargins">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_classic"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="@string/mode_name_classic"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_infinite"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="@string/mode_name_infinite"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_walls"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="@string/mode_name_walls"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <!-- Amistoso (Sandbox) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mode_sandbox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingEnd="40dp"
                    android:text="Amistoso"
                    android:background="@drawable/btn_retro_classic"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_config_sandbox_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:background="@drawable/btn_retro_classic"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_online"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="ONLINE"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_lan"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="LAN"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_dual_core"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="@string/mode_dual_core"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mode_sysadmin"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:text="@string/mode_sysadmin"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textStyle="bold" />

        </GridLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
