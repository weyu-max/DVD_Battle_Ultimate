<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".CharacterActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4" />

    <!-- Left side: Preview -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toTopOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <View
            android:id="@+id/player_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/player_color" />

        <ImageView
            android:id="@+id/preview_eyes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/eye_normal" />

        <ImageView
            android:id="@+id/preview_mouth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/mouth_happy" />
    </FrameLayout>

    <!-- Top Tabs for P1/P2 -->
    <LinearLayout
        android:id="@+id/player_tabs_container"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tab_p1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PLAYER 1"
            android:textSize="14sp"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tab_p2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="PLAYER 2"
            android:textSize="14sp"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- Right side: Tabs and Selection -->
    <LinearLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@id/player_tabs_container">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_cores"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/tab_cores"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_olhos"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/tab_olhos"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_bocas"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/tab_bocas"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tab_aura"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/tab_aura"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:background="@drawable/btn_retro_classic" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toBottomOf="@id/tabs_container">

        <LinearLayout
            android:id="@+id/options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cores section -->
            <GridLayout
                android:id="@+id/section_cores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4">
                <!-- Buttons will be here -->
            </GridLayout>

            <!-- Olhos section -->
            <GridLayout
                android:id="@+id/section_olhos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:visibility="gone">
                <!-- Buttons will be here -->
            </GridLayout>

            <!-- Bocas section -->
            <GridLayout
                android:id="@+id/section_bocas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:visibility="gone">
                <!-- Buttons will be here -->
            </GridLayout>

            <!-- Aura section -->
            <GridLayout
                android:id="@+id/section_aura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:visibility="gone">
                <!-- Buttons will be here -->
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_back"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/btn_retro_classic"
        android:text="@string/btn_back"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>