<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextView
        android:id="@+id/lan_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/label_lan_party"
        android:textColor="@color/imperial_yellow"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/lan_selection_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/lan_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_host_lan"
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:layout_margin="16dp"
            android:background="@drawable/btn_retro_classic"
            android:text="@string/btn_host_game"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_join_lan"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_retro_classic"
            android:text="@string/btn_join_game"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_online_mode"
            android:layout_width="160dp"
            android:layout_height="120dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_retro_classic"
            android:text="ONLINE (WIFI DIFERENTE)"
            android:textColor="@color/imperial_blue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Online Setup Container -->
    <LinearLayout
        android:id="@+id/online_setup_container"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/lan_title"
        app:layout_constraintBottom_toTopOf="@id/btn_back_lan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MULTIJOGADOR ONLINE"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edit_room_code"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="CÓDIGO PRIVADO"
                android:textColor="@color/white"
                android:textColorHint="@color/gray"
                android:background="@drawable/edittext_retro"
                android:gravity="center"
                android:textAllCaps="true"
                android:maxLength="10"
                android:inputType="textCapCharacters" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_online_join"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_retro_classic"
                android:text="ENTRAR"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_online_host"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_retro_classic"
            android:text="CRIAR SALA PÚBLICA"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALAS DISPONÍVEIS:"
            android:textColor="@color/imperial_blue"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/online_rooms_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/text_searching_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscando salas..."
            android:textColor="@color/gray"
            android:layout_gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/host_config_container"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lan_title"
        app:layout_constraintBottom_toTopOf="@id/btn_create_room"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_host_menu"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <CheckBox
                android:id="@+id/check_lan_boss_rush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_bots_rush"
                android:textColor="@color/white" />

            <CheckBox
                android:id="@+id/check_lan_friendly_fire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_friendly_fire"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_friends_count_max"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/text_lan_friends_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/imperial_blue"
                    android:textSize="18sp"
                    android:layout_marginHorizontal="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_create_room"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/btn_retro_classic"
        android:text="@string/btn_create_room"
        android:textColor="@color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Join Menu (Initially Gone) -->
    <LinearLayout
        android:id="@+id/join_menu_container"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lan_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_join_menu"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/rooms_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/text_searching_rooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_searching_rooms"
            android:textColor="@color/imperial_blue"
            android:layout_gravity="center"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lobby_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/lan_title"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_lobby"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/players_lobby_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_waiting_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_waiting_players"
            android:textColor="@color/hp_red"
            android:layout_marginTop="32dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_lan_play"
            android:layout_width="200dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_retro_classic"
            android:text="@string/btn_play"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:enabled="false" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_back_lan"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/btn_retro_classic"
        android:text="@string/btn_back"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>