<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Left: Profile and Rank -->
        <LinearLayout
            android:id="@+id/profile_rank_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/btn_retro_classic"
            android:padding="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/profile_mini_character"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="8dp">
                <View
                    android:id="@+id/profile_color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/imperial_yellow" />
                <ImageView
                    android:id="@+id/profile_eyes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/eye_normal" />
                <ImageView
                    android:id="@+id/profile_mouth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mouth_happy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_menu_rank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRONZE 1"
                    android:textColor="@color/black"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <ProgressBar
                    android:id="@+id/progress_menu_rank"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="90dp"
                    android:layout_height="8dp"
                    android:layout_marginVertical="2dp"
                    android:max="100"
                    android:progressTint="@color/imperial_blue" />
                <TextView
                    android:id="@+id/text_menu_upload_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/black"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top Right: Moedas -->
        <LinearLayout
            android:id="@+id/blocks_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/btn_retro_classic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:background="@color/imperial_yellow" />

            <TextView
                android:id="@+id/text_total_blocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center: Character Preview -->
        <FrameLayout
            android:id="@+id/menu_player_preview_container"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:id="@+id/menu_player_color"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/player_color" />

            <ImageView
                android:id="@+id/menu_player_eyes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/eye_normal" />

            <ImageView
                android:id="@+id/menu_player_mouth"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/mouth_happy" />
        </FrameLayout>

        <!-- Right: Vertical Buttons -->
        <LinearLayout
            android:id="@+id/right_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/blocks_container"
            app:layout_constraintBottom_toTopOf="@id/play_area_container"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_loja"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="LOJA"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_achievements"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="MISSÕES"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_config"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:text="CONFIG"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Bottom Left: Meta Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_personagem"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="PERSONAGEM"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_upgrades"
                android:layout_width="100dp"
                android:layout_height="60dp"
                android:text="DRIVERS"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Right: Play Button -->
        <LinearLayout
            android:id="@+id/play_area_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/text_selected_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODO: CLASSIC"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold|italic"
                android:layout_marginBottom="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_modos"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:text="ALTERAR MODO"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_jogar"
                android:layout_width="200dp"
                android:layout_height="80dp"
                android:text="JOGAR"
                android:background="@drawable/btn_retro_classic"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold|italic" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
